{
  "expo": {
    "name": "AGP Fincas",
    "slug": "agpapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "agpapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AGP Fincas necesita tu ubicación para situar la incidencia que estás reportando."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "AGP Fincas necesita la cámara para hacer una foto de la incidencia.",
          "photosPermission": "AGP Fincas necesita tus fotos para adjuntar una imagen a la incidencia."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
